<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
 <persistence-unit
            name="nbd"
            transaction-type="RESOURCE_LOCAL">

        <provider>
            org.hibernate.jpa.HibernatePersistenceProvider
        </provider>

        <class>pobi.infrastructure.jpa.entity.ClientEnt</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property
                    name="jakarta.persistence.jdbc.driver"
                    value="org.postgresql.Driver"/>

            <property
                    name="jakarta.persistence.jdbc.url"
                    value="jdbc:postgresql://127.0.0.1:5433/nbddb"/>

            <property
                    name="jakarta.persistence.jdbc.user"
                    value="nbd"/>

            <property
                    name="jakarta.persistence.jdbc.password"
                    value="nbdpassword"/>

            <property
                    name="hibernate.hbm2ddl.auto"
                    value="update"/>

            <property
                    name="hibernate.show_sql"
                    value="true"/>

            <property
                    name="hibernate.format_sql"
                    value="true"/>

            <property
                    name="hibernate.connection.isolation"
                    value="2"/>
        </properties>
    </persistence-unit>
</persistence>
